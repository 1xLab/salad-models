FROM ghcr.io/ggml-org/llama.cpp:server-cuda

RUN apt-get update && apt-get install -y --no-install-recommends rclone ca-certificates && rm -rf /var/lib/apt/lists/*

COPY start-nemotron.sh /app/start.sh
RUN chmod +x /app/start.sh

ENV LLAMA_ARG_HOST="::" \
    LLAMA_ARG_PORT="8080" \
    LLAMA_ARG_MODEL="/models/model.gguf" \
    LLAMA_ARG_N_GPU_LAYERS="auto" \
    LLAMA_ARG_CTX_SIZE="131072" \
    LLAMA_ARG_N_PARALLEL="1" \
    LLAMA_ARG_ALIAS="nemotron3-nano-30b-a3b" \
    LLAMA_ARG_TOP_K="20" \
    LLAMA_ARG_JINJA="on" \
    LLAMA_ARG_FLASH_ATTN="on" \
    LLAMA_ARG_FIT="on" \
    LLAMA_ARG_CACHE_TYPE_K="q4_0" \
    LLAMA_ARG_CACHE_TYPE_V="q4_0" \
    LLAMA_SERVER_TEMP="0.7" \
    LLAMA_SERVER_TOP_P="0.80" \
    LLAMA_SERVER_MIN_P="0.0"

ENTRYPOINT ["/app/start.sh"]
